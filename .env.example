# Supabase — proyecto (Settings > API en tu dashboard de Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Solo para scripts server-side (importador). NUNCA exponer en el cliente.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Usuario dueño de los datos importados (tu user id de Supabase Auth).
# Lo obtienes tras registrarte: Authentication > Users en el dashboard.
IMPORT_USER_ID=your-auth-user-uuid

# Compatibilidad temporal del MCP con el token personal de Claude Code.
# El conector de Claude usa OAuth de Supabase y no necesita variables nuevas.
# Después de migrar todos los clientes a OAuth, estas dos variables son opcionales.
MCP_ACCESS_TOKEN=your-long-random-personal-token
MCP_USER_ID=your-auth-user-uuid
